{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "composite": true,
  "include": [
    "src/renderer/env.d.ts",
    "src/renderer/**/*",
    "src/renderer/**/*.svelte",
    "src/preload/*.d.ts"
  ],
  "compilerOptions": {
    "verbatimModuleSyntax": true,
    "useDefineForClassFields": true,
    "strict": false,
    "allowJs": true,
    "checkJs": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "paths": {
      "$lib/*": ["./src/renderer/lib/*"],
      "$units/*": ["./src/renderer/units/*"]
    }
  }
}
